{
  "name": "betterbukidnon-web",
  "version": "2.0.0",
  "private": true,
  "description": "BetterBukidnon.org - volunteer civic portal for the Province of Bukidnon",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.js",
    "check:routes": "vitest run src/features/seo/routes.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "version:major": "node scripts/bump-version.js major",
    "version:minor": "node scripts/bump-version.js minor",
    "version:patch": "node scripts/bump-version.js patch",
    "version:check": "node scripts/bump-version.js",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "bukidnon",
    "northern-mindanao",
    "province",
    "government",
    "lgu"
  ],
  "author": "BetterBukidnon contributors",
  "contributors": [
    "Ramon Logan Jr. (original BetterSolano template)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Better-Bukidnon/betterbukidnon.git"
  },
  "homepage": "https://betterbukidnon.org",
  "license": "MIT",
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "tmp": "0.2.7",
    "js-yaml": "^4.2.0",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "chart.js": "^4.6.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-bootstrap-icons": "^1.11.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^6.0.0"
  }
}
