{
  // Cloudflare Workers static-assets deploy. `npm run build` writes the site to dist/.
  "name": "betterbukidnon",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    // /services/health serves services/health.html; /budget/ serves budget/index.html
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
